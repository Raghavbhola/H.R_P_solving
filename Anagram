def anagram(s):
    # Write your code here
    n = len(s)// 2
# print(s[:n], s[n:])
    s1 = sorted(s[:n])
    s2 = sorted(s[n:])
    print(s1,s2)
    count = 0
    for i in range(n):
        if s1[i] != s2[i]:
            count += 1
    if n // 2:
        return count
    else:
        return "-1"            

