from collections import Counter

def anagram(s):
    # Write your code here
    if len(s) % 2 != 0:
        return "-1"
    else:    
        n = len(s)// 2
    # print(s[:n], s[n:])
    
        s1 = s[:n]
        s2 = s[n:]
        # print(s1,s2)
        c1 = Counter(s1)
        c2 = Counter(s2)
        count = 0
        for ch in c1:
            if c1[ch] > c2[ch]:
                count += c1[ch] - c2[ch]
        return count       

if __name__ == '__main__':
    fptr = open(os.environ['OUTPUT_PATH'], 'w')

    q = int(input().strip())

    for q_itr in range(q):
        s = input()

        result = anagram(s)

        fptr.write(str(result) + '\n')

    fptr.close()
